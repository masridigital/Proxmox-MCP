# Proxmox MCP broker: settings (no secrets).
#
# Secrets are NOT environment variables. Put them in the credentials directory:
#   enrollment.json, pve-token-<name> (one per person), worker-identity.pub
# See README.md (Configuration) and docs/RUNBOOK.md.
# All values below are examples. Replace every <placeholder>.

# --- Credentials directory (one of the two) -------------------------------------------
# Windows broker (files ACL'd to NT SERVICE\ProxmoxMCPBroker, optional DPAPI *.dpapi files)
BROKER_CREDENTIALS_DIR=C:\ProgramData\ProxmoxMCP\credentials
# BROKER_DPAPI_ENTROPY_FILE=C:\ProgramData\ProxmoxMCP\dpapi-entropy
# Linux: systemd sets CREDENTIALS_DIRECTORY from LoadCredential=; do not set it here.

# --- Proxmox VE API ---------------------------------------------------------------------
PROXMOX_HOST=pve.example.internal
PROXMOX_PORT=8006
# TLS: give a CA bundle, or the SHA-256 fingerprint of the Proxmox certificate, or both.
# PROXMOX_CA_BUNDLE=C:\ProgramData\ProxmoxMCP\pve-ca.pem
PROXMOX_TLS_FINGERPRINT=<sha256-hex-of-the-proxmox-certificate>
# Never set PROXMOX_INSECURE_TLS=1 outside a disposable lab. It disables verification.
# Kill switch: refuse every POST, PUT and DELETE, whatever the user's mode.
PROXMOX_READ_ONLY=false
# PROXMOX_TIMEOUT=30

# --- Broker HTTP listener -------------------------------------------------------------
# Loopback only. cloudflared on the same host is the only client.
MCP_BIND=127.0.0.1
MCP_PORT=8765
# Host header values the broker accepts (DNS rebinding defense).
MCP_ALLOWED_HOSTS=<broker-hostname>,127.0.0.1:8765

# --- Cloudflare Access (the broker's own Access application) ------------------------------
CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=<broker-access-application-aud-tag>
# Client ID of the Worker's Access service token (comma list during rotation).
BROKER_ALLOWED_SERVICE_CLIENT_IDS=<worker-service-token-client-id>.access
# 1 = require the Access service-token JWT (tunnel hostname mode, default).
# 0 = Workers VPC mode only; identity assertions and the loopback bind still apply.
BROKER_REQUIRE_ACCESS_JWT=1

# --- Policy -----------------------------------------------------------------------------
# Admin tier (create, delete, configure guests) stays off unless this is 1.
MCP_ALLOW_ADMIN_TOOLS=0
# Optional restrictions (they can only remove tools):
# MCP_TOOL_DENY=^delete_,migrate
# MCP_TOOL_ALLOW=list_nodes,list_vms,get_vm_status
# Redact and refuse e-mail addresses and phone numbers as PHI too.
# MCP_PHI_CONTACT=1

# --- Limits -----------------------------------------------------------------------------
MCP_RATE_PER_MIN=60
MCP_RATE_PER_DAY=2000
# MCP_MAX_REQUEST_BYTES=262144
# MCP_MAX_RESULT_BYTES=2097152

# --- Audit ------------------------------------------------------------------------------
MCP_AUDIT_LOG=C:\ProgramData\ProxmoxMCP\logs\audit.jsonl
